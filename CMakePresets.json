{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-asan",
      "displayName": "Debug + ASan/UBSan",
      "description": "Memory error and undefined behavior detection",
      "inherits": "debug",
      "cacheVariables": {
        "LIBGLOT_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "debug-tsan",
      "displayName": "Debug + ThreadSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "LIBGLOT_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (O2 + LTO)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIBGLOT_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "bench",
      "displayName": "Release + benchmarks",
      "inherits": "release",
      "cacheVariables": {
        "LIBGLOT_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI Build",
      "description": "Warnings as errors, tests on",
      "inherits": "debug",
      "cacheVariables": {
        "LIBGLOT_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "jobs": 0 },
    { "name": "debug-asan", "configurePreset": "debug-asan", "jobs": 0 },
    { "name": "debug-tsan", "configurePreset": "debug-tsan", "jobs": 0 },
    { "name": "release", "configurePreset": "release", "jobs": 0 },
    { "name": "bench", "configurePreset": "bench", "jobs": 0 },
    { "name": "ci", "configurePreset": "ci", "jobs": 0 }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-asan",
      "configurePreset": "debug-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:check_initialization_order=1:strict_init_order=1"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-tsan",
      "configurePreset": "debug-tsan",
      "environment": { "TSAN_OPTIONS": "second_deadlock_stack=1" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true }
    }
  ]
}
